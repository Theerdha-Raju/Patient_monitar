# =======================================================================
# COVID Patient Health Monitor in Quarantine - Environment Configuration
# =======================================================================

# FastAPI Server Gateway Configuration
PORT=5000
HOST=0.0.0.0
ENVIRONMENT=development

# PostgreSQL / TimescaleDB Database Credentials
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=covid_monitor_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/covid_monitor_db

# Frontend Web Application Configuration
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws/readings
VITE_PORT=3000

# Telemetry & Polling Settings
DEFAULT_PATIENT_ID=P001
POLLING_INTERVAL_MS=3000
DEVICE_OFFLINE_TIMEOUT_SEC=30
